# Replace with the exact HTTPS origin assigned by Tailscale Serve, no trailing slash.
R2_ORIGIN=https://r2.example.ts.net
R2_DATA_DIR=/var/lib/r2
R2_PORT=3000
R2_SESSION_TTL_HOURS=168
R2_PAUSE_NOTIFICATIONS=false

# Set these in /etc/r2/r2.env; never commit real values.
# R2_PASSWORD_HASH=$scrypt$...
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:owner@example.com
# OPENAI_API_KEY=
# OPENAI_MODEL=
